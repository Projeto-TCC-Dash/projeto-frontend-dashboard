{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthContract",
  "description": "Especificação dos contratos de autenticação (cadastro e login)",
  "endpoints": {
    "register": {
      "method": "POST",
      "path": "/api/auth/register",
      "description": "Cria um novo usuário na plataforma",
      "request": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "E-mail válido do usuário"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Senha com no mínimo 8 caracteres"
          }
        }
      },
      "responses": {
        "200": {
          "description": "Usuário criado com sucesso",
          "body": {
            "type": "object",
            "required": ["token", "user"],
            "properties": {
              "token": { "type": "string" },
              "user": {
                "type": "object",
                "required": ["id", "email", "hasAiKey"],
                "properties": {
                  "id": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "hasAiKey": { "type": "boolean" }
                }
              }
            }
          }
        },
        "400": {
          "description": "E-mail duplicado ou dados inválidos",
          "body": {
            "type": "object",
            "required": ["message"],
            "properties": {
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "login": {
      "method": "POST",
      "path": "/api/auth/login",
      "description": "Autentica um usuário existente",
      "request": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "responses": {
        "200": {
          "description": "Login realizado com sucesso",
          "body": {
            "type": "object",
            "required": ["token", "user"],
            "properties": {
              "token": { "type": "string" },
              "user": {
                "type": "object",
                "required": ["id", "email", "hasAiKey"],
                "properties": {
                  "id": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "hasAiKey": { "type": "boolean" }
                }
              }
            }
          }
        },
        "401": {
          "description": "Credenciais inválidas",
          "body": {
            "type": "object",
            "required": ["message"],
            "properties": {
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
