{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserAiKeyContract",
  "description": "Especificação do contrato para configuração e teste ativo da chave de API Google AI Studio",
  "endpoints": {
    "setAiKey": {
      "method": "PUT",
      "path": "/api/user/ai-key",
      "headers": {
        "Authorization": "Bearer <JWT_TOKEN>"
      },
      "request": {
        "type": "object",
        "required": ["apiKey"],
        "properties": {
          "apiKey": {
            "type": "string",
            "minLength": 20,
            "description": "Chave da API Google AI Studio (formato típico AIzaSy...)"
          }
        }
      },
      "responses": {
        "200": {
          "description": "Chave testada e salva com sucesso",
          "body": {
            "type": "object",
            "required": ["success", "message"],
            "properties": {
              "success": { "type": "boolean" },
              "message": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["ACTIVE_VERIFIED", "ACTIVE_PROVISIONAL_DEMAND"]
              }
            }
          }
        },
        "400": {
          "description": "Chave rejeitada ou inválida no teste de conexão com o provedor",
          "body": {
            "type": "object",
            "required": ["success", "message"],
            "properties": {
              "success": { "type": "boolean", "enum": [false] },
              "message": { "type": "string" }
            }
          }
        },
        "401": {
          "description": "Sessão não autenticada ou token inválido",
          "body": {
            "type": "object",
            "required": ["message"],
            "properties": {
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
